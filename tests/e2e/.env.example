# Separate Discord application credentials. Never use a user token.
E2E_DISCORD_TOKEN=
E2E_GUILD_ID=
E2E_TEXT_CHANNEL_ID=
E2E_VOICE_CHANNEL_ID=
E2E_EOLIAN_BOT_ID=

E2E_TARGET=local
E2E_TRIGGER_MODE=chat

E2E_SOURCE=youtube
E2E_REQUEST_TYPE=url
E2E_REQUEST=https://www.youtube.com/watch?v=HEXWRTEbj1I
E2E_TIMEOUT_MS=90000
E2E_MIN_PACKETS=5
E2E_MIN_PCM_BYTES=3840
E2E_MIN_RMS=50

# Required together only when E2E_TARGET=production.
E2E_ALLOW_PRODUCTION=false
E2E_PRODUCTION_CONFIRM=
