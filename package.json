{
  "name": "eolian",
  "version": "1.0.0",
  "description": "A bot for music enthusiasts",
  "private": true,
  "scripts": {
    "build:node": "yarn typecheck:node && vite build --config vite.node.config.mts",
    "build:web": "yarn typecheck:web && vite build --config vite.web.config.mts",
    "build": "yarn typecheck:test && yarn build:node && yarn build:web",
    "build-dev:node": "yarn typecheck:node && vite build --mode development --config vite.node.config.mts",
    "build-dev:web": "yarn typecheck:web && vite build --mode development --config vite.web.config.mts",
    "build-dev": "yarn typecheck:test && yarn build-dev:node && yarn build-dev:web",
    "start": "node -r dotenv/config ./dist/bundle.js -gi",
    "start-debug": "node -r dotenv/config --inspect-brk ./dist/bundle.js -gi",
    "e2e": "yarn e2e:build && node dist/e2e/harness.mjs",
    "e2e:build": "vite build --config vite.e2e.config.mts",
    "test": "yarn test:unit",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:web": "vitest run --config vitest.web.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts --passWithNoTests",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "typecheck:node": "tsc -p src/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck": "yarn typecheck:node && yarn typecheck:web && yarn typecheck:test",
    "format": "prettier --write README.md \"docs/**/*.md\" package.json index.html \"vite*.mts\" \"vitest*.mts\" \".github/workflows/*.yml\" \"src/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"web/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check README.md \"docs/**/*.md\" package.json index.html \"vite*.mts\" \"vitest*.mts\" \".github/workflows/*.yml\" \"src/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"web/**/*.{ts,tsx,css}\""
  },
  "keywords": [
    "music",
    "bot",
    "discord",
    "spotify",
    "soundcloud"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "resolutions": {
    "@snazzah/davey": "0.1.12",
    "detect-libc": "2.1.2"
  },
  "author": "Jack Belford",
  "license": "GPL-3.0+",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "^2.6.0",
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "0.1.12",
    "bufferutil": "^4.0.8",
    "discord-api-types": "^0.38.37",
    "discord.js": "14.27.0",
    "dotenv": "^16.0.2",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.2.0",
    "fuzzball": "^2.1.2",
    "googleapis": "^169.0.0",
    "html-entities": "^2.3.3",
    "iso8601-duration": "^2.1.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.41.0",
    "mongodb": "^4.11.0",
    "node-cache": "^5.1.2",
    "node-gyp": "^10.2.0",
    "openai": "^6.15.0",
    "pm2": "7.0.4",
    "prism-media": "^1.3.5",
    "sodium-native": "^4.3.1",
    "undici": "^7.16.0",
    "utf-8-validate": "^6.0.4",
    "winston": "^3.8.2",
    "zlib-sync": "^0.1.10"
  },
  "devDependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/dotenv": "^8.2.0",
    "@types/jsdom": "^30",
    "@types/node": "^22.12.0",
    "@types/node-cache": "^4.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/winston": "^2.4.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "30.1.1",
    "prettier": "^3.4.2",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.4.1+sha224.fd21d9eb5fba020083811af1d4953acc21eeb9f6ff97efd1b3f9d4de"
}
